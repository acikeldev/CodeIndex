root = true

[*]
charset = utf-8
end_of_line = crlf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true

[*.{csproj,props,targets,xml,config}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Naming conventions
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_prefix
dotnet_naming_rule.private_fields_underscore.severity = warning

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private

dotnet_naming_style.underscore_prefix.capitalization = camel_case
dotnet_naming_style.underscore_prefix.required_prefix = _

# Prefer explicit types
dotnet_diagnostic.IDE0008.severity = warning

# Require braces
dotnet_diagnostic.IDE0011.severity = warning

# MessagePack init-with-initializer (MsgPack017): safe here. Every [Key] is always serialized (full-object
# cache writes) and any model shape change bumps the cache schema version (older caches are discarded and
# rebuilt, never partially deserialized), so a missing key can never silently reset a collection default.
dotnet_diagnostic.MsgPack017.severity = none

# CA1812 (avoid uninstantiated internal classes): a false-positive magnet for types instantiated only via DI,
# a factory, or a Lazy<T> closure (e.g. the cache/snapshot helpers). Off — real dead code is caught in review.
dotnet_diagnostic.CA1812.severity = none
